#%RAML 1.0 DataType
# LSP after: one response type for every order variation.
# Variation-specific data goes in additionalInfo, so consumers written for one
# order type keep working with the others.
type: object
properties:
  orderId: string
  orderType:
    enum: [standard, express, international]
  totalPrice: number
  currency: string
  additionalInfo:
    type: object | nil
    required: false
